# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server + seeding only, never client

# Anthropic — the AI coach (optional; the chips work without it)
ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-haiku-4-5   # default; swap for a bigger model if you want

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the privacy policy and terms tell people to write (a real, read inbox).
# NEXT_PUBLIC_CONTACT_EMAIL=
# Typed-session (free text) limit per account per day. Default 40.
# COACH_DAILY_LIMIT=40

# Stripe: trainer billing, $5 a player a month (optional; off until set).
# Needs SUPABASE_SERVICE_ROLE_KEY above and migration 0037.
# STRIPE_SECRET_KEY=sk_test_...
# From the webhook you add in Stripe, pointing at https://train.futbol/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Only if you made the $5 price by hand; otherwise it's made on first use.
# STRIPE_PRICE_ID=price_...
