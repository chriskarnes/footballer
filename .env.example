# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server + seeding only, never client

# Anthropic — the AI coach (optional; the chips work without it)
ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-haiku-4-5   # default; swap for a bigger model if you want

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
